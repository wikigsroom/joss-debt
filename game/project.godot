; Incense Debt — native shared simulation, Godot 4.7.2.
config_version=5

[application]
config/name="香火债"
config/version="0.2.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="以余烬连债、焚账回灰为核心的剪纸肉鸽。"
config/icon="res://assets/ui/app-icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="IncenseDebt"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.09, 0.1, 0.09, 1)

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
driver/mix_rate=48000
