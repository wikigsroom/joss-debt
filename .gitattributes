# Preserve the exact source bytes used by the recorded SHA-256 evidence.
* -text whitespace=cr-at-eol
# Two trailing spaces are meaningful Markdown line breaks.
*.md text eol=lf whitespace=-blank-at-eol,cr-at-eol
*.png binary -delta
*.jpg binary -delta
*.webp binary -delta
*.gif binary -delta
*.ogg binary -delta
*.wav binary -delta
*.ttf binary

# Preserve audited generation prompts, third-party notices and deployed legal HTML.
output/imagegen/**/prompts/*.txt whitespace=-blank-at-eof,cr-at-eol
output/**/licenses/*.txt whitespace=-blank-at-eol,cr-at-eol
sites/privacy-policy/*.html whitespace=-blank-at-eol,cr-at-eol
sites/privacy-policy/**/*.html whitespace=-blank-at-eol,cr-at-eol
