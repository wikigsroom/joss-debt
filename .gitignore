# Local engines, SDKs and Godot import caches.
/.local-tools/
**/.godot/
**/__pycache__/
*.py[cod]
*.tmp

# Locally exported applications. Keep build instructions and artifact metadata.
/build/*
!/build/README.md
!/build/delivery-manifest.json
!/build/ios-handoff/
/build/ios-handoff/*
!/build/ios-handoff/README.md
!/build/ios-handoff/handoff.json

# Reproducible uncompressed audio masters and redundant QA frames.
/output/audio/score-masters/
/output/audio/*.wav
/docs/incense-debt/reports/**/*.png
/docs/incense-debt/reports/**/*.gif
/docs/incense-debt/reports/**/*.wav
/docs/incense-debt/reports/**/*.log
/docs/incense-debt/reports/**/isolated-saves/

# Credentials and machine-local editor settings.
.env
.env.*
!.env.example
**/export_credentials.cfg
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
/.vscode/
/.idea/
Thumbs.db
.DS_Store

